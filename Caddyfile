{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Firebase Auth's sign-in helper served from our own domain (set NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN to DOMAIN),
	# so Google sign-in works where *.firebaseapp.com is slow or blocked and without third-party storage.
	handle /__/auth/* {
		reverse_proxy https://{$FIREBASE_AUTH_HOST} {
			header_up Host {upstream_hostport}
		}
	}
	handle /__/firebase/* {
		reverse_proxy https://{$FIREBASE_AUTH_HOST} {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		reverse_proxy app:3000
	}
}
