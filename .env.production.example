# Copy to .env.production on the server. Never commit the real file.

DOMAIN=startum.ai
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string

NODE_ENV=production
APP_URL=https://startum.ai
# Must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://app:change-me-to-a-long-random-string@postgres:5432/app
REDIS_URL=redis://redis:6379

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI: OpenAI GPT-5 mini (platform.openai.com → API keys). "anthropic" also works; "mock" = canned data, dev only.
# Calls use minimal reasoning, prompt caching and short replies to keep cost low. Per-client limits and a daily
# platform spend cap are set in Admin → Settings → AI limits.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL_FAST=gpt-5-mini
AI_MODEL_SMART=gpt-5-mini
# Optional: override cost estimates (USD per million tokens) if OpenAI's prices change.
AI_PRICE_INPUT=
AI_PRICE_CACHED_INPUT=
AI_PRICE_OUTPUT=

SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# MVP design screens: "builtin" works with no key (styled screens from the project's data).
# "stitch" = AI designs with Google Stitch (stitch.withgoogle.com → Settings → API key). "mock" = test placeholders, dev only.
DESIGN_PROVIDER=builtin
STITCH_API_KEY=

# --- Gold Mine ------------------------------------------------------------------
# Keyword volume + trend data. "dataforseo" (https://app.dataforseo.com/api-access) or "mock" (dev only).
KEYWORD_PROVIDER=dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Google Ads location/language codes (2840 = United States).
KEYWORD_LOCATION_CODE=2840
KEYWORD_LANGUAGE_CODE=en
# Discussion sources for the Pain Miner, comma-separated: "web" (generic page reader), "reddit"
# (Reddit's public JSON — Reddit's Data API terms require approval for commercial use; enable only if you have it).
DISCUSSION_SOURCES=web

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FOUNDER_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=

RESEND_API_KEY=
EMAIL_FROM=

SENTRY_DSN=
WORKER_CONCURRENCY=2
