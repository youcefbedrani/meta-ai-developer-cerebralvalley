# Copy to .env.production on the server. Never commit the real file.

DOMAIN=startum.ai
ACME_EMAIL=you@example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string

NODE_ENV=production
APP_URL=https://startum.ai
# Must match POSTGRES_PASSWORD above.
DATABASE_URL=postgres://app:change-me-to-a-long-random-string@postgres:5432/app
REDIS_URL=redis://redis:6379
# Admin console access (comma-separated). Admins see the admin console instead of the founder app,
# so use a different email from the one you test the product with.
ADMIN_EMAILS=

NEXT_PUBLIC_FIREBASE_API_KEY=
# Use your own DOMAIN here (not <project>.firebaseapp.com): Caddy relays /__/auth/* to Firebase, so Google sign-in
# works where firebaseapp.com is blocked. Add https://DOMAIN/__/auth/handler to the Google OAuth client's redirect URIs.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI: per-client limits and a daily platform spend cap are set in Admin → Settings → AI limits.
# "anthropic", "openai" and other OpenAI-compatible gateways also work; "mock" = canned data, dev only.
# Meta Model API (Muse Spark). Voice, images and page review also use this key.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.meta.ai/v1
AI_API_KEY=
AI_MODEL_FAST=muse-spark-1.3
AI_MODEL_SMART=muse-spark-1.3
VOICE_MODEL=muse-voice-transcribe-1.0
# Interview audio and generated images: /data/uploads in the app and worker images (the shared "uploads" volume).
# Leave UPLOAD_DIR unset here so that default applies.
# Optional: Muse Spark Open on Baseten / Modal / vLLM for the operations listed (see .env.example).
OPEN_MODEL_BASE_URL=
OPEN_MODEL_API_KEY=
OPEN_MODEL=
OPEN_MODEL_OPERATIONS=
# Muse Spark Open always reasons: low (default) or medium.
OPEN_MODEL_REASONING=
# Optional: override cost estimates (USD per million tokens) if OpenAI's prices change.
AI_PRICE_INPUT=
AI_PRICE_CACHED_INPUT=
AI_PRICE_OUTPUT=

SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# MVP design screens: "muse" = Meta Muse Spark designs every screen as a clickable prototype (uses the AI key above).
# "builtin" works with no key (styled screens from the project's data).
# "stitch" = AI designs with Google Stitch (stitch.withgoogle.com → Settings → API key). "mock" = test placeholders, dev only.
DESIGN_PROVIDER=muse
STITCH_API_KEY=

# --- Gold Mine ------------------------------------------------------------------
# Keyword volume + trend data. "dataforseo" (https://app.dataforseo.com/api-access) or "mock" (dev only).
KEYWORD_PROVIDER=dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Google Ads location/language codes (2840 = United States).
KEYWORD_LOCATION_CODE=2840
KEYWORD_LANGUAGE_CODE=en
# Discussion sources for the Pain Miner, comma-separated: "web" (generic page reader), "reddit"
# (Reddit's public JSON — Reddit's Data API terms require approval for commercial use; enable only if you have it).
DISCUSSION_SOURCES=web

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FOUNDER_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=

RESEND_API_KEY=
EMAIL_FROM=

SENTRY_DSN=
WORKER_CONCURRENCY=2

# Social publishing for launch videos (optional; each platform is on when its app credentials are set).
# SOCIAL_TOKEN_SECRET encrypts the connected accounts' tokens: 32+ random characters (openssl rand -hex 32).
# Redirect URLs to register in each developer app: {APP_URL}/api/social/linkedin/callback, …/meta/callback, …/tiktok/callback
SOCIAL_TOKEN_SECRET=
# LinkedIn: developer app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect".
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Meta: app with Facebook Login for Business; permissions pages_manage_posts, instagram_content_publish (app review to go public).
META_APP_ID=
META_APP_SECRET=
# TikTok: developer app with Login Kit + Content Posting API (video.upload scope sends videos to the user's inbox).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
