# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# Integrations left blank show a clear "missing configuration" message in the
# UI instead of pretending to work.
# ---------------------------------------------------------------------------

# --- Core (required) --------------------------------------------------------
APP_URL=http://localhost:3100
DATABASE_URL=postgres://app:app@localhost:5460/app
REDIS_URL=redis://localhost:6390

# --- Firebase Auth (required for login) --------------------------------------
# Console -> Project settings -> General -> Your apps -> Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the quotes; \n sequences are converted to newlines automatically.
FIREBASE_ADMIN_PRIVATE_KEY=

# Local development / tests only: point both SDKs at the Firebase Auth emulator
# (pnpm emulator). Use a "demo-*" project id. Leave empty in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- AI (Iteration 2) ---------------------------------------------------------
# AI: OpenAI GPT-5 mini (platform.openai.com → API keys) or Claude (AI_PROVIDER=anthropic, key from
# platform.claude.com → API keys, starts with "sk-ant-"); "mock" = canned data, dev only.
# Calls use low effort/reasoning, prompt caching and short replies to keep cost low. Per-client limits and a daily
# platform spend cap are set in Admin → Settings → AI limits.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL_FAST=gpt-5-mini
AI_MODEL_SMART=gpt-5-mini
# Claude instead:
#   AI_PROVIDER=anthropic
#   AI_MODEL_FAST=claude-opus-5-5     (claude-haiku-5-5 is much cheaper for quick tasks and chat)
#   AI_MODEL_SMART=claude-opus-5-5
# Through a gateway/proxy instead of the provider's own API (use https):
#   AI_BASE_URL=https://gateway.example.com/v1
#   AI_PROVIDER=anthropic           if the gateway speaks Anthropic's Messages API (/v1/messages)
#   AI_PROVIDER=openai-compatible   if it speaks OpenAI's Chat Completions API (/v1/chat/completions)
# Meta's Muse models (Meta Model API, dev.meta.ai):
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://api.meta.ai/v1
#   AI_MODEL_FAST=muse-spark-1.3
#   AI_MODEL_SMART=muse-spark-1.3
AI_BASE_URL=
# openai-compatible only: how structured (JSON) answers are requested. "json_schema" when the gateway supports
# response_format json_schema (the default for api.meta.ai), "prompt" otherwise (the default elsewhere).
AI_STRUCTURED_OUTPUT=
# Voice (interview recordings, voice pitches): Meta Muse Voice Transcribe on the same Meta Model API key.
# Needs AI_BASE_URL=https://api.meta.ai/v1 and ffmpeg on the server.
VOICE_MODEL=muse-voice-transcribe-1.0
# Where interview audio is stored (mount a volume here in production).
UPLOAD_DIR=
# Optional: override cost estimates (USD per million tokens) if OpenAI's prices change.
AI_PRICE_INPUT=
AI_PRICE_CACHED_INPUT=
AI_PRICE_OUTPUT=

# --- Web research (Iteration 3) -----------------------------------------------
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
# MVP design screens: "builtin" works with no key (styled screens from the project's data).
# "stitch" = AI designs with Google Stitch (stitch.withgoogle.com → Settings → API key). "mock" = test placeholders, dev only.
DESIGN_PROVIDER=builtin
STITCH_API_KEY=

# --- Gold Mine ------------------------------------------------------------------
# Keyword volume + trend data. "dataforseo" (https://app.dataforseo.com/api-access) or "mock" (dev only).
KEYWORD_PROVIDER=dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Google Ads location/language codes (2840 = United States).
KEYWORD_LOCATION_CODE=2840
KEYWORD_LANGUAGE_CODE=en
# Discussion sources for the Pain Miner, comma-separated: "web" (generic page reader), "reddit"
# (Reddit's public JSON — Reddit's Data API terms require approval for commercial use; enable only if you have it).
DISCUSSION_SOURCES=web

# --- Stripe (Iteration 6) -----------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FOUNDER_MONTHLY=
STRIPE_PRICE_STUDIO_MONTHLY=

# --- Email --------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --- Monitoring (optional) ----------------------------------------------------
SENTRY_DSN=

# --- Idea Marketplace (feature flag, off by default) ---
# MARKETPLACE_PAYMENTS=stripe uses Stripe Connect (needs STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET).
# MARKETPLACE_PAYMENTS=mock simulates payments for development; refused in production.
MARKETPLACE_ENABLED=false
MARKETPLACE_PAYMENTS=stripe
MARKETPLACE_FEE_PERCENT=10
MARKETPLACE_AUTO_CONFIRM_DAYS=7
ADMIN_EMAILS=
