{
  "name": "saas-start-here",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "emulator": "firebase emulators:start --only auth --project demo-stratum",
    "check": "pnpm typecheck && pnpm lint && pnpm build",
    "worker": "tsx --conditions=react-server --env-file=.env worker/index.ts",
    "worker:dev": "tsx watch --conditions=react-server --env-file=.env worker/index.ts",
    "seed:demo": "tsx --env-file=.env scripts/seed-demo.ts",
    "e2e:ai": "node --env-file=.env --conditions=react-server --import tsx scripts/e2e-ai.ts",
    "ai:smoke": "node --env-file=.env --conditions=react-server --import tsx scripts/ai-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/openai": "^4.0.96",
    "@base-ui/react": "^1.9.0",
    "@google/stitch-sdk": "^0.3.5",
    "@hookform/resolvers": "^5.9.2",
    "@mozilla/readability": "^0.6.0",
    "@sentry/nextjs": "^11.8.0",
    "ai": "^7.0.143",
    "bullmq": "^6.3.16",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "ioredis": "^6.0.0",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "stripe": "^23.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "15.34.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.4.0"
}
